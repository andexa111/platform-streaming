// Prisma Schema — Sinea Streaming Platform
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Role {
  guest
  user
  subscriber
  admin
  superadmin
}

enum SubStatus {
  inactive
  pending
  active
  expired
}

enum PaymentStatus {
  pending
  paid
  cancelled
}

// ==================== USERS ====================

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String?   // nullable untuk Google OAuth
  avatar_url        String?
  role              Role      @default(guest)
  email_verified_at DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscriptions  Subscription[]
  payments       Payment[]
  tokens         EmailToken[]
  filmViews      FilmView[]
  watchHistories WatchHistory[]

  @@map("users")
}

// ==================== FILMS ====================

model Film {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?   @db.Text
  producer     String?
  director     String?
  duration     Int?      // durasi dalam menit
  release_year Int?
  poster_url   String?
  trailer_url  String?
  video_id     String?   // Bunny Stream video ID
  clip_start   Int?      // detik mulai highlight trailer
  clip_end     Int?      // detik akhir highlight trailer
  is_published          Boolean   @default(false)
  is_deleted            Boolean   @default(false)
  scheduled_at          DateTime?
  production_house      String?
  production_house_logo String?
  createdAt             DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  genres         Genre[]        @relation("FilmGenres")
  actors         Actor[]        @relation("FilmActors")
  filmViews      FilmView[]
  watchHistories WatchHistory[]
  featuredFilms  FeaturedFilm[]

  @@map("films")
}

// ==================== GENRE & ACTOR ====================

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique

  films Film[] @relation("FilmGenres")

  @@map("genres")
}

model Actor {
  id   Int    @id @default(autoincrement())
  name String

  films Film[] @relation("FilmActors")

  @@map("actors")
}

// ==================== VIEWS & WATCH HISTORY ====================

model FilmView {
  id              Int      @id @default(autoincrement())
  filmId          Int
  userId          Int
  watched_seconds Int      @default(0)
  counted         Boolean  @default(false) // sudah dihitung sebagai 1 view?
  createdAt       DateTime @default(now())

  film Film @relation(fields: [filmId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("film_views")
}

model WatchHistory {
  id            Int      @id @default(autoincrement())
  userId        Int
  filmId        Int
  last_position Int      @default(0) // posisi terakhir dalam detik
  is_completed  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  film Film @relation(fields: [filmId], references: [id])

  @@unique([userId, filmId]) // 1 user = 1 record per film
  @@map("watch_histories")
}

// ==================== MEMBERSHIP PLANS ====================

model MembershipPlan {
  id          Int      @id @default(autoincrement())
  slug        String   @unique       // "paket_1", "paket_2", etc.
  name        String                 // "Paket 1"
  price          Int                    // harga per bulan (Rupiah)
  duration_months Int     @default(1)    // durasi paket dalam bulan
  benefits       String[]               // array benefit
  max_devices    Int      @default(1)
  quality        String   @default("720p")
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  discounts     Discount[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("membership_plans")
}

// ==================== DISCOUNTS ====================

model Discount {
  id           Int      @id @default(autoincrement())
  planId       Int
  label        String                // "Promo Launching", "Diskon Spesial"
  percentage   Int?                  // diskon persen (0-100)
  fixed_amount Int?                  // atau potongan flat (Rupiah)
  valid_from   DateTime
  valid_until  DateTime
  is_active    Boolean  @default(true)
  createdAt    DateTime @default(now())

  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@map("discounts")
}

// ==================== FEATURED FILMS ====================

model FeaturedFilm {
  id        Int      @id @default(autoincrement())
  filmId    Int
  position  Int      @unique        // urutan 1-10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  film Film @relation(fields: [filmId], references: [id])

  @@map("featured_films")
}

// ==================== SUBSCRIPTION & PAYMENT ====================

model Subscription {
  id            Int       @id @default(autoincrement())
  userId        Int
  planId        Int                   // referensi ke MembershipPlan
  status        SubStatus @default(inactive)
  expired_at    DateTime?
  reminder_sent Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User           @relation(fields: [userId], references: [id])
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Payment {
  id        Int           @id @default(autoincrement())
  order_id  String        @unique
  userId    Int
  planId    Int                      // referensi ke MembershipPlan
  amount    Int                      // nominal dalam Rupiah (setelah diskon)
  status    PaymentStatus @default(pending)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User           @relation(fields: [userId], references: [id])
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@map("payments")
}

// ==================== ADS ====================

model Ad {
  id        Int      @id @default(autoincrement())
  title     String
  duration  Int      // durasi dalam detik
  video_url String
  is_active Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ads")
}

// ==================== EMAIL TOKEN ====================

model EmailToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("email_tokens")
}
